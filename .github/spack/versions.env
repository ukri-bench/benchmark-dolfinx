# Spack versions for all workflows in this repository. Read by
# .github/actions/setup-spack, which installs Spack with them and exports the
# NAME=value lines to later steps.
#
# Use the same values as ukri-bench/spack-packages (.github/spack/versions.env)
# so dependencies have the same hashes and come from its build cache.

# Spack release
SPACK_VERSION=v1.2.2
# spack/spack-packages (builtin package repository) commit
SPACK_PACKAGES_COMMIT=731577eee0004659abb29a12e42d4c52a48e7285
